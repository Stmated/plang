
val Holder = struct {
  val value: uint32;
};

val Tr = trait {
    val add = (a: uint32, b: uin32): uin64;
};

val Tr = impl for Person {
    val add = (self, a, b) => {
        return a + b + self.value;
    };
};

val main = () => {

    val p = new Person { 1 };
    val partial = p.fn~(b = 10);

    // will call with a=1, b=10
    val result = partial(100); // should be 111
};
