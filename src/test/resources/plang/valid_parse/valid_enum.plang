
// uint8: Backed by a number, kept in runtime
// symbol: Backed by compile-time symbol, removed in runtime

val Enum = type { A: uint8 | B: $T | C: symbol };

// They must all be callable in this fashion:
val e1 = new Enum.B { 1 }; // NOTE: Is this ugly? We do "alloc" something by giving value (?)
val e2 = Enum.C;
