
val fn = (v: ($T1, $T2)): $T3
    where T1: Add
    where T2: Add = T1
    where T3: Add = T1 | T2 => {
    return v[0] + v[1];
};

// Can only specify the types by name if given as "where" entries
fn(uint8)((1, 2));
fn(T1 = uint8)((1, 2)); // First = uint8, Returns = uint8
fn(uint8, $T3 = uint64)((1, 2)); // First = uint8, Returns = uint64

val fn2 = (t: (v1: Add, v2: $TV2)): @(t::v1.type & TV2) where TV2: Add => {
    return t.v1 + t.v2;
};

val Point = ($T) where T: Number => struct {
  x: T;
  y: T;
};

var p = new Point(uint64) { x = 1, y = 2 };

