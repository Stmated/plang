
val StructABC = struct {A: uint8; B: uint8; C: uint8; };
val StructADE = struct {A: uint8, D: uint8; E: uint8 };

val agg = {
    ...StructABC { A = 1, B = 2, C = 3, };
    ...StructADE {A = 4; D = 5, E = 6 },
};
val v = agg.A + agg.B + agg.D; // = 4 + 2 + 5 = 11

val map = ['A' = 1, 'B' = 2, 'C' = 3, ];
map.put('D', 4);
