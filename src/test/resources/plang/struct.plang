val Foo = struct {
  a: uint32;
  val b: uint32;
};

val Bar = struct {
  c: uint32;
  val d: uint32;
};

val Baz = struct {
  var d: uint32;
  val e: uint32;
};

val FooTrait = trait {
  val calculate1 = (ref val self): uint32;
  val calculate2 = (self): uint32;
  calculate3 = (): uint32 | uint64;
};

impl FooTrait for Foo + Bar {
  val calculate1 = (ref val self) => self.a + self.b;
  calculate2 = (self) => self.a + self.c;
  val calculate3 = () => self.b + self.d;
}

val aNewType = (Foo | Bar) - Baz;

impl SomethingFunny for aNewType {
  val toggle1 = (self): 0 | 1 => !self;
  val toggle2 = (self): (if self 0 else 1) => !self;
  val toggle3 = (self): (if self then 0 else 1) => !self;
}

val one = 1.toString();
var number = 12.13;
number_also_val = 14.15;
number_decimal: float = 16.17;

val globalFunction1 = () => {
  1 + 1;
};
var globalFunction2 = () => {
  return 1 + 1;
};
val globalFunction3 = () => {
  return 1 + 1;
};
val globalFunction4 = () => return 1 + 1;
val globalFunction5 = () => 1 + 1;
val globalFunction6 = () => 1 + 1;
val globalFunction7 = => 1 + 1;
globalFunction8 = => 1 + 1;
globalFunction9 ==> 1 + 1;

val array1 = [1, 2, 3];
array2 = [1, 2, 3];
// Quick creation without property keys should go to field "value"
// If there are several entries without property keys, it is expected that "value" is an array
val array3 = Array { 1, 2, 3 };
val array4 = Array { initial = 6, 1, 2, 3 };
val array5 = Array<float> { initial = 6, 1, 2, 3 };

// Vec = pointer, capacity, length
val vec1 = Vector { 1, 2, 3 }; // Variable-sized array where memory is consecutive
val list1 = List { 1, 2, 3 }; // Variable-sized Linked array where memory is not consecutive

val array1_0 = array1[0];
val array1_slice = array1[0..1]; // Slice is a view into original -- mutable or immutable?
val array1_filtered1 = array1[v => v > 2];

// "it" is the default implicit name for single-argument lambdas
val array1_filtered2 = array1[=> it > 2];

Person = struct {
  GivenName: string = 'Pontus';
  value: string;
};

/*
This is a multiline comment
*/
val quickObject = Person { FamilyName = 'Eliason', /* will be set to 'value' */ "198706046615" };

val quickObject = Person {
  FamilyName = 'Eliazon',
  // below has no key, so will set property "value"
  "191212121212"
};
