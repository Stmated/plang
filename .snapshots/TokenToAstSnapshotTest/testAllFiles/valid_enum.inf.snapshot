dynamic-directory: true
snapshot-name: valid_enum.inf
snapshot-number: 0
test-class: org.inf.ast.raising.TokenToAstSnapshotTest
test-method: testAllFiles

(Program
  (Expressions
    (Comment " uint8: Backed by a number, kept in runtime")
    (Comment " symbol: Backed by compile-time symbol, removed in runtime")
    (Comment " val Enum = type { A: uint8 | B: $T | C: symbol };")
    (Comment " B's type will not be comparable to other uint8 -- because the type is nominal.")
    (Comment " C will be a compile-time symbol that only works in static situations and is lost at runtime.")
    (Assignment
      (VariableDeclaration
        (Lexeme "Enum")
        Immutable
        false)
      (Labeling
        (Lexeme "A")
        (Labeling
          (BinaryOperation BIT_OR
            (Lexeme "uint8")
            (Lexeme "B"))
          (Lexeme "nominal"))))
    (Labeling
      (BinaryOperation BIT_OR
        (Lexeme "uint8")
        (Lexeme "C"))
      (Lexeme "symbol"))
    (NoOp)
    (Comment " They must all be callable in this fashion:")
    (Assignment
      (VariableDeclaration
        (Lexeme "e1")
        Immutable
        false)
      (New
        (DotAccess
          (Lexeme "Enum")
          (Lexeme "B"))
        (Lexeme "stack")
        (Block
          (Literal "1"))))
    (NoOp)
    (Comment " NOTE: Is this ugly? We do \"alloc\" something by giving value (?)")
    (Assignment
      (VariableDeclaration
        (Lexeme "e2")
        Immutable
        false)
      (DotAccess
        (Lexeme "Enum")
        (Lexeme "C")))
    (NoOp)
    (Match
      (Paren
        (Lexeme "e2"))
      (Expressions
        (Callable
          (DotAccess
            (Lexeme "Enum")
            (Lexeme "A"))
          (PostfixExpression
            (Lexeme "println")
            (Paren
              (Lexeme "e2"))))
        (Callable
          (DotAccess
            (Lexeme "Enum")
            (Lexeme "B"))
          (PostfixExpression
            (Lexeme "println")
            (Paren
              (Lexeme "e2"))))
        (Callable
          (DotAccess
            (Lexeme "Enum")
            (Lexeme "C"))
          (PostfixExpression
            (Lexeme "println")
            (Paren
              (Literal "Matched symbol"))))))))